# Copy to .env for local development. Env vars take precedence over configs/gateway.yaml.
# Secrets must ONLY live here / in the environment — never in YAML.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
GATEWAY_LOG_LEVEL=INFO
GATEWAY_CONFIG_PATH=configs/gateway.yaml
# Optional routing overrides (M1):
# GATEWAY_DEFAULT_PROVIDER=mock-a
# GATEWAY_MOCK_LATENCY_MS=0
# GATEWAY_MOCK_FAIL_RATE=0.0
# M2 resilience overrides (env wins over configs/gateway.yaml resilience block):
# GATEWAY_RETRY_MAX_ATTEMPTS=2
# GATEWAY_RETRY_BACKOFF_BASE_MS=50
# GATEWAY_RETRY_BACKOFF_MAX_MS=1000
# GATEWAY_RETRY_MAX_ELAPSED_MS=8000
# GATEWAY_CIRCUIT_FAILURE_THRESHOLD=5
# GATEWAY_CIRCUIT_RECOVERY_TIMEOUT_S=30
# GATEWAY_CIRCUIT_HALF_OPEN_INFLIGHT=1
# Future (M2+) secrets — reserved, not used in M1:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
